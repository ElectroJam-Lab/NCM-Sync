{
  "name": "ncm-sync",
  "version": "1.3.3",
  "private": true,
  "description": "网易云音乐歌单本地同步工具",
  "main": "src/main/main.cjs",
  "author": "NCM Sync contributors",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env CLOUDMUSIC_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/unit/*.test.cjs tests/integration/*.test.cjs",
    "test:e2e": "npm run build && playwright test",
    "test:packaged": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/packaged-smoke.ps1",
    "test:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/installer-smoke.ps1",
    "test:all": "npm test && npm run test:e2e",
    "screenshot:public": "npm run build && node scripts/capture-public-screenshot.cjs",
    "profile:performance": "npm run build && node scripts/profile-performance.cjs",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "express": "5.2.1",
    "ffmpeg-static": "5.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "cross-env": "10.1.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "vite": "8.1.5",
    "wait-on": "9.0.10"
  },
  "build": {
    "appId": "app.ncmsync.desktop",
    "productName": "NCM Sync",
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/ffmpeg-static/ffmpeg"
    ],
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/backend/**/*",
      "assets/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/ncmsync-icon.ico",
      "artifactName": "NCMSync-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
